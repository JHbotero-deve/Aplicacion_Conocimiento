generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  id              Int       @id @default(autoincrement())
  nombre_usuario  String    @unique @db.VarChar(255)
  contrasena_hash String    @db.VarChar(255)
  rol_usuario     String    @db.VarChar(50)
  fecha_creacion  DateTime? @default(now()) @db.Timestamp(6)
}

model ganado {
  chapeta         String   @id @db.VarChar(50)
  raza            String   @db.VarChar(100)
  edad            Int
  peso            Float
  fecha_ingreso   DateTime @db.Date
  estadoica       String   @db.VarChar(50)
  certificado_ica Boolean
  bloqueado       Boolean
}
